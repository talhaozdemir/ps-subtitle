{
  "name": "ps-subtitle",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "SETUP_SESSIONS", "class_name": "SetupSession" }]
  },
  "migrations": [{ "tag": "setup-v1", "new_sqlite_classes": ["SetupSession"] }],
  "ratelimits": [
    {
      "name": "SETUP_LIMIT",
      "namespace_id": "273428159",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
